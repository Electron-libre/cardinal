# Development commands. `just` lists them; the agent harness uses the same entry points.
import 'cardinal.just'

default:
    @just --list

# Format, lint (warning-free) and test, then check the specs; prints nothing on success.
check: fmt clippy test check-specs

fmt:
    @cargo fmt --all

clippy:
    @cargo clippy -q --all-targets -- -D warnings

# The output of the tests, only when they fail.
test:
    #!/usr/bin/env sh
    out=$(cargo test -q 2>&1) || { printf '%s\n' "$out"; exit 1; }
